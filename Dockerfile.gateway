FROM python:3.11-slim AS base

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# gateway/generated/ (protobuf stubs) is committed to the repo and copied
# as-is below -- regenerating here would be dead work, since the later
# `COPY gateway ./gateway` always overwrites any freshly generated stubs
# with the committed ones anyway. Only regenerate locally via
# scripts/gen_protos.sh after editing protos/demo.proto, then commit.
COPY gateway ./gateway

# Runs as root: acceptable for this project's documented scope (demo,
# docker-compose/localhost network, no public exposure) -- not hardened
# for production deployment.
ENV PYTHONUNBUFFERED=1
CMD ["python", "-m", "gateway.server"]
