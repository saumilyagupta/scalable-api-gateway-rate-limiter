FROM python:3.11-slim AS base

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# gateway/generated/ (protobuf stubs) is committed to the repo and copied
# as-is below -- regenerating here would be dead work, since it would be
# discarded by this same COPY anyway. Only regenerate locally via
# scripts/gen_protos.sh after editing protos/demo.proto, then commit.
COPY demo_services ./demo_services
COPY gateway/generated ./gateway/generated
COPY gateway/__init__.py ./gateway/__init__.py

# Runs as root: acceptable for this project's documented scope (demo,
# docker-compose/localhost network, no public exposure) -- not hardened
# for production deployment.
ENV PYTHONUNBUFFERED=1
